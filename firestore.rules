rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function roleOf(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? get(/databases/$(database)/documents/roles/$(uid)).data.role
        : 'member';
    }

    function isOwner() {
      return request.auth != null && (
        request.auth.token.email == 'justin@scheduler.app' ||
        roleOf(request.auth.uid) == 'owner'
      );
    }

    function isAdminOrAbove() {
      return isOwner() ||
        (request.auth != null && roleOf(request.auth.uid) == 'admin');
    }

    function isStaffOrAbove() {
      return isAdminOrAbove() ||
        (request.auth != null && roleOf(request.auth.uid) == 'staff');
    }

    // True only if the user has explicitly opted their profile page into
    // public visibility (directory/{uid}.profilePublic == true). Defaults
    // to false/private when the directory doc doesn't exist or the field
    // is unset, so financial data stays owner-only unless opted in.
    function isProfilePublic(uid) {
      return exists(/databases/$(database)/documents/directory/$(uid)) &&
        get(/databases/$(database)/documents/directory/$(uid)).data.profilePublic == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /expenses/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isProfilePublic(userId));
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /debts/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isProfilePublic(userId));
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /goals/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /investments/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isProfilePublic(userId));
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared goals with an invite/accept flow. Confirmed members and
    // not-yet-accepted invitees ('pendingMembers') can both read (so an
    // invitee can see what they're being invited to) and update (so they
    // can accept — moving themselves into 'members' — or decline). Only
    // confirmed members can delete the goal outright.
    match /sharedGoals/{goalId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.members || request.auth.uid in resource.data.pendingMembers);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.members || request.auth.uid in resource.data.pendingMembers);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // Directory of every user who has ever signed in — written by each user
    // for their own uid on login (so anyone with panel access can find and
    // grant/hide someone, not just people who've saved a goal or shift).
    // Staff and above can also write other users' entries, to toggle
    // leaderboard visibility.
    match /directory/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isStaffOrAbove());
    }

    // Role assignments. Anyone signed in can read (needed to show/hide the
    // Admin Panel card and gate its features client-side). Owners can set
    // anyone to any role; Admins can only set Staff or Member (so an Admin
    // can't promote themselves or someone else to Admin/Owner). Staff can't
    // write roles at all.
    match /roles/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner() ||
        (isAdminOrAbove() && request.resource.data.role in ['staff', 'member']);
    }

    // Shared app configuration, e.g. the community challenge shown on the
    // leaderboard. Everyone can read it; Admin and above can edit it.
    match /config/{documentId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrAbove();
    }

    // Shared cache of live stock/crypto prices (Market page, Investments'
    // live-linked holdings). Purely public market data with no per-user
    // scope, so any signed-in client can refresh it — whoever notices it's
    // stale re-fetches from the price APIs and writes the result back here,
    // so the third-party rate limit (shared across every user of the app)
    // gets hit roughly once per cache window instead of once per client.
    match /market/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // One doc per friendship, in every state (pending -> accepted) — id is
    // the two uids sorted and joined, so there's never more than one doc
    // between two people. Both parties can read/update/delete regardless of
    // who sent the request, so either side can accept, decline, cancel, or
    // remove. Only the sender can create, and only with status 'pending' —
    // you can't create an already-accepted friendship for yourself.
    match /friendRequests/{requestId} {
      // resource is null when no doc exists yet at this id — both
      // sendFriendRequest() and the schedule.html friend-view checker do a
      // getDoc() *before* any relationship exists, to see whether one
      // already does. Without the resource == null branch, accessing
      // resource.data on a null resource throws inside the rule itself,
      // which Firestore treats as permission-denied rather than "not
      // found" — silently breaking every first-time friend request.
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.from
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Personal notifications. Only the owner can read their own — these
    // aren't public like 'directory' or 'market'. Write is open to any
    // signed-in user because sending someone a notification means writing
    // into *their* doc (e.g. a friend request), same trust model already
    // used for 'directory' writes from other users.
    match /notifications/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null;
    }
  }
}
